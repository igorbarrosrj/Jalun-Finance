# =============================================
# CREDOR RADAR / JALUN FINANCE — Variáveis de Ambiente
# Copie para .env e preencha os valores reais
# NUNCA commite o .env no repositório
# =============================================

# --- Banco de dados ---
# Desenvolvimento local (docker-compose):
DATABASE_URL=postgresql://radar:radar@localhost:5432/credor_radar
# Produção (docker-compose.prod.yml — postgres roda como serviço interno):
# DATABASE_URL=postgresql://radar:SENHA_FORTE@postgres:5432/credor_radar

# --- Credenciais do Postgres (produção) ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA
POSTGRES_DB=credor_radar

# --- Redis / BullMQ ---
REDIS_URL=redis://localhost:6379
# Produção: REDIS_URL=redis://redis:6379

# --- Anthropic / Claude ---
# Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Autenticação NextAuth v5 ---
# Gere com: openssl rand -base64 32
AUTH_SECRET=GERE_COM_OPENSSL_RAND_BASE64_32
AUTH_URL=https://jalun.com.br
# Desenvolvimento: AUTH_URL=http://localhost:4001

# --- Admin inicial ---
# Usado pelo script: npm run seed:admin
ADMIN_EMAIL=admin@jalun.com.br
ADMIN_PASSWORD=TROQUE_APOS_PRIMEIRO_LOGIN
ADMIN_NOME=Administrador

# --- Servidor API ---
PORT=4000
# Produção (dentro do Docker): PORT=3001
NODE_ENV=development

# --- Web (Next.js) ---
# URL pública da API — usada pelo browser (client-side)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Produção: NEXT_PUBLIC_API_URL=https://api.jalun.com.br

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:4001,http://localhost:3000,https://jalun.com.br
# Produção: ALLOWED_ORIGINS=https://jalun.com.br

# --- Storage de PDFs ---
STORAGE_PATH=./storage
# Produção: STORAGE_PATH=/app/storage

# --- Logs ---
LOG_LEVEL=info
