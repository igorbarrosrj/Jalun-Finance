# =============================================
# CREDOR RADAR — Variáveis de Ambiente
# Copie para .env e preencha os valores reais
# NUNCA commite o .env no repositório
# =============================================

# --- Banco de dados ---
# Desenvolvimento local (docker-compose):
DATABASE_URL=postgresql://radar:radar@localhost:5432/credor_radar
# Produção (Dokploy gerencia automaticamente ao adicionar Postgres como serviço):
# DATABASE_URL=postgresql://USER:PASS@HOST:PORT/credor_radar

# --- Redis / BullMQ ---
# Desenvolvimento local (docker-compose):
REDIS_URL=redis://localhost:6379
# Produção (Dokploy gerencia automaticamente ao adicionar Redis como serviço):
# REDIS_URL=redis://HOST:PORT

# --- Anthropic / Claude ---
# Obtenha em: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxx

# --- Servidor ---
PORT=3001
NODE_ENV=development

# --- Storage de PDFs ---
# Desenvolvimento: filesystem local
STORAGE_PATH=./storage
# TODO Fase 2: migrar para S3-compatible (Backblaze B2 ou MinIO)
# S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
# S3_BUCKET=credor-radar-pdfs
# S3_ACCESS_KEY=xxx
# S3_SECRET_KEY=xxx

# --- Logs ---
LOG_LEVEL=info

# --- CORS ---
# Lista de origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3003,http://localhost:3000
# Produção: ALLOWED_ORIGINS=https://credorradar.com.br
