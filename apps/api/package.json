{
  "name": "@credor-radar/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:scheduler": "tsx src/jobs/run-all.ts",
    "scrape:aj-ruiz": "tsx src/scrapers/aj-ruiz.ts",
    "scrape:r4c": "tsx src/scrapers/r4c/index.ts",
    "build": "tsup src/index.ts --format cjs --out-dir dist --clean",
    "build:workers": "tsup src/jobs/worker.ts --format cjs --out-dir dist --clean",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "seed:admin": "tsx prisma/seed-admin.ts",
    "extract:pending": "tsx src/jobs/extract-pending.ts",
    "reprocessar:b": "tsx src/jobs/reprocessar-b.ts",
    "score:reprocess": "tsx src/jobs/rescore-todos.ts",
    "cron:renovacao": "tsx src/jobs/cron-renovacao.ts",
    "cron:alertas": "tsx src/jobs/cron-alertas.ts",
    "cron:historico": "tsx src/jobs/cron-historico-passivo.ts",
    "seed:planos": "tsx prisma/seed-planos.ts",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@credor-radar/shared": "*",
    "@prisma/client": "^5.22.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.34.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ioredis": "^5.4.1",
    "jsonrepair": "^3.14.0",
    "pdf-parse": "^1.1.1",
    "pino": "^9.5.0",
    "playwright": "^1.49.1",
    "resend": "^6.12.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.17.9",
    "@types/pdf-parse": "^1.1.4",
    "pino-pretty": "^13.0.0",
    "prisma": "^5.22.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
